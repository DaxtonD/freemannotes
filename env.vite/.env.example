# Vite build-time env vars (only VITE_* are exposed to the client)
# Copy to env.vite/.env.production or env.vite/.env.development if needed.

# Optional: override Vite dev/preview ports.
# Useful if you want to run dev behind a reverse proxy on a specific port.
# VITE_DEV_PORT=5173
# VITE_PREVIEW_PORT=4173

# Optional override. Usually leave unset and let the app use same-origin /yjs.
# VITE_WS_URL=wss://dev.freeman.daxtond.com/yjs

# Optional: where Vite should proxy /api/* and /uploads/* in dev.
# If you run `npm run dev`, the backend defaults to http://localhost:27015.
# VITE_API_PROXY_TARGET=http://localhost:27015

# Optional: embed an in-memory Yjs websocket backend inside Vite on /yjs.
# Development mode always embeds Yjs (this flag is ignored in `vite dev`).
# This flag only affects non-dev modes when explicitly used.
# VITE_YJS_EMBED=1

# Optional: force /yjs websocket proxy to backend in dev (off by default).
# Development mode ignores this and never proxies /yjs.
# This flag only affects non-dev modes when explicitly used.
# VITE_YJS_PROXY=1

# Push notifications — VAPID public key (exposed to the browser via /api/push/vapid-public-key,
# but you can also bake it in at build time via this env var for faster first load).
# Generate a key pair with: npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY=

# Note card loading effect.
#   0 = simple CSS shimmer (default, low overhead)
#   1 = HL2 Combine electric-fence crackle SVG overlay
# VITE_NOTE_CARD_EFFECT=0

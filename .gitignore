node_modules/
dist/
dist-*/
.tmp-notegrid-build/

# Runtime env (local / docker-compose env_file)
.env
# Real Docker connection config (holds DB/Redis IPs + secrets). The .example
# template stays tracked; the filled-in copy must not be committed.
.env.docker

# Vite env files (build-time)
env.vite/.env
env.vite/.env.*
!env.vite/.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
freeman-debug.log
.npm-start.log

# Local diagnostic dumps (NoteGrid card-height captures, etc.)
card-diag-*.json

# Python bytecode. server/ocrRunner.py is the only Python we ship, but importing it to test
# its parsing leaves a __pycache__ next to it.
__pycache__/
*.py[cod]

# Working notes kept in the repo root: plans, verification scripts, scratch diagnostics.
# They live here so they're next to the code while being worked on, but they're personal
# working material rather than part of the project, and `git add -A` would otherwise sweep
# them into a release commit (it has tried).
*-plan.md
verification-test-procedure-*.md
*-diagnostic-*.md
notes-grid-restore-plan.md
stopserver.txt

# AI assistant files and settings (not part of the codebase)
CLAUDE.md
CLAUDE_CONTEXT.md
.claude/
.cursor/
CURSOR_CONTEXT.md
.aider*
.anthropic/
*.cursorrules
.clinerules
memory/

# Windsurf
.windsurf/
.windsurfrules

# Copilot
.github/copilot-instructions.md

# Gemini / Google AI
.gemini/

# Continue (VS Code extension)
.continue/

# Codeium / Windsurf
.codeium/

# Tabnine
.tabnine/

# Generic AI context files
AGENTS.md
.ai/
.aiexclude

# Local Yjs persistence artifacts
.yjs-data/

# Local troubleshooting captures
screenjitter.mp4

# Prisma generated client (regenerated on npm install / prisma generate)
# The schema.prisma file IS tracked; the generated output is NOT.
node_modules/.prisma/

# Legal review packet — strategy notes and questions for counsel. Never publish.
legal-review/

{
	"name": "freemannotes",
	"version": "1.7.6",
	"main": "index.js",
	"scripts": {
		"dev": "concurrently -k -n server,web \"npm run dev:server\" \"npm run dev:web\"",
		"dev:web": "node scripts/run-dev-web.cjs",
		"predev:server": "npm run db:generate:if-needed",
		"dev:server": "node scripts/run-dev-server.cjs",
		"prestart": "npm run db:generate:if-needed && npm run db:init",
		"start": "npm run build && node server.js",
		"prestart:server": "npm run db:generate:if-needed && npm run db:init",
		"start:server": "node server.js",
		"db:init": "node server/dbInitCli.js",
		"preview": "vite preview --host",
		"ws": "node ws-server.js",
		"build": "node scripts/build-to-dist.cjs",
		"db:generate": "prisma generate",
		"db:generate:if-needed": "node scripts/prisma-generate-if-needed.cjs",
		"db:migrate": "prisma migrate dev",
		"db:migrate:deploy": "prisma migrate deploy",
		"db:migrate:status": "prisma migrate status",
		"db:push": "prisma db push",
		"postinstall": "npm run db:generate:if-needed",
		"release:patch": "npm version patch --tag-version-prefix=\"\" -m \"chore(release): %s\" && git push && git push --tags",
		"release:minor": "npm version minor --tag-version-prefix=\"\" -m \"chore(release): %s\" && git push && git push --tags",
		"release:major": "npm version major --tag-version-prefix=\"\" -m \"chore(release): %s\" && git push && git push --tags",
		"test": "node --test tests/"
	},

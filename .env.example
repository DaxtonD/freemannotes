# Copy to .env for local runs.

NODE_ENV=production
PORT=27015
# Bind host for server.js (use 0.0.0.0 in containers)
HOST=0.0.0.0
# Optional public base URL used for startup logs (does not change routing)
# APP_URL=https://dev.freeman.daxtond.com

# Optional: enable Yjs server persistence (LevelDB).
# YPERSISTENCE=/data/yjs

# Optional override. Usually leave unset and let the app use same-origin /yjs.
# VITE_WS_URL=wss://dev.freeman.daxtond.com/yjs

# ─── Debug Logging ───────────────────────────────────────────────────
# Set to 1 to enable structured server-side debug logging (freeman-debug.log).
# DEBUG_LOGGING=0
# Set to 1 to enable structured debug logging (freeman-debug.log).
# Client events are batched and POSTed to /api/debug-log.
# VITE_DEBUG_LOGGING=0

# ─── PostgreSQL (Prisma) ─────────────────────────────────────────────
# Required for server-side Yjs document persistence.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://freemannotes:freemannotes@localhost:5432/freemannotes?schema=public

# Optional: control schema sync behavior at startup.
# - deploy: applies committed migrations (recommended)
# - push:   prisma db push (dev convenience)
# - none:   skip automatic schema sync
DB_SCHEMA_SYNC=deploy

# ─── PostgreSQL Timezone ──────────────────────────────────────────────
# IANA timezone name used for displaying timestamps from PostgreSQL.
# Internal storage remains UTC; this setting only affects how timestamps
# are presented in API responses and query results.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# PGTIMEZONE=America/Regina
# PGTIMEZONE=America/Chicago
# PGTIMEZONE=Europe/London

# ─── Redis (optional) ────────────────────────────────────────────────
# When set, the server caches Yjs doc state in Redis for faster loads
# and can use pub/sub for multi-instance coordination.
# Format: redis://[:PASSWORD@]HOST:PORT
# REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://:yourpassword@localhost:6379

# ─── Workspace Cleanup ──────────────────────────────────────────────
# Soft-deleted workspaces are permanently removed after this grace period.
# Default shown here matches the server fallback (24 hours).
WORKSPACE_CLEANUP_GRACE_MS=86400000
# How often the cleanup scheduler scans for expired soft-deleted workspaces.
# Default shown here matches the server fallback (60 minutes).
WORKSPACE_CLEANUP_INTERVAL_MS=3600000
# How often the trash cleanup scheduler scans for notes that passed their
# auto-delete deadline. Default shown here matches the server fallback.
TRASH_CLEANUP_INTERVAL_MS=3600000

# ─── Auth (Phase 11) ────────────────────────────────────────────────
# Required for JWT cookie sessions (register/login).
# Use a long random value in production.
AUTH_JWT_SECRET=change-me-in-production
# Optional overrides
# AUTH_COOKIE_NAME=freemannotes_session
# Force cookies to be marked Secure. Set this when TLS terminates at a reverse
# proxy in front of the app.
# AUTH_COOKIE_SECURE=true
# Leave unset (default), or set to never/0, to keep auth effectively
# non-expiring with a long-lived persistent cookie.
# Set a positive number to enforce a rolling expiration window in days.
# AUTH_SESSION_DAYS=14
# AUTH_BCRYPT_ROUNDS=12
# AUTH_ALLOW_REGISTER=true

# ─── SMTP (Invites + Email Notification Fallback) ────────────────────
# Required for workspace invite emails.
# Also required when any *_NOTIFICATION_MODE uses email delivery.
# Registration still requires a valid email address because FreemanNotes
# identifies accounts by email and email-mode reminders are sent there.
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Freeman Notes <no-reply@example.com>"

# ─── Uploads ─────────────────────────────────────────────────────────
# Directory where profile images are stored.
# In Docker, map a volume to this path.
UPLOAD_DIR=/app/uploads

# Max long-edge pixel dimension and JPEG quality (0.1-1.0) applied to every
# image on upload and in-app camera capture. Higher = sharper images but more
# server storage and upload bandwidth per image — this is the main lever for
# balancing image quality against storage budget as your user count grows.
# At the default (2560px @ 0.82), a typical photo runs roughly 300-600KB
# (less for flat/high-contrast content like document or whiteboard scans,
# more for busy detailed photos). Budget approximately:
#   0.5MB x (images per user) x (number of users)
# when sizing the uploads volume. Existing images are not reprocessed when
# you change this — it only affects new uploads/captures going forward.
# IMAGE_CAPTURE_MAX_DIMENSION_PX=2560
# IMAGE_CAPTURE_JPEG_QUALITY=0.82

# ─── OCR ─────────────────────────────────────────────────────────────
# Set to 1 to disable OCR entirely.
# OCR_DISABLED=0
# Set to 1 to stream OCR child-process output into the server logs.
# OCR_LOG_OUTPUT=0
# Override only when you need a custom OCR runtime or cache location.
# OCR_PYTHON_BIN=python3
# PADDLE_HOME=
# PADDLE_PDX_MODEL_SOURCE=BOS

# ─── External Notifications ──────────────────────────────────────────
# Choose delivery per platform:
#   auto  = push when configured, otherwise email if SMTP is configured
#   push  = push only
#   email = email only
#   off   = disable external reminder/test notifications for that platform
# Desktop browsers use WEB. Android browsers/PWAs use ANDROID. iOS uses IOS.
# WEB_NOTIFICATION_MODE=auto
# ANDROID_NOTIFICATION_MODE=auto
# IOS_NOTIFICATION_MODE=auto

# VAPID keys for Web Push (Web + Android PWA/browser).
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Firebase Cloud Messaging (iOS via Capacitor).
# Download the service-account JSON from Firebase Console →
# Project Settings → Service Accounts → Generate new private key,
# then copy the relevant fields below.
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
